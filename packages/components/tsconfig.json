{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // core is type-checked from source through paths, so it must sit under rootDir
        "rootDir": "..",
        "noEmit": true,
        "paths": {
            "@lucentis/headless-ui-core": ["../core/src/index.ts"]
        }
