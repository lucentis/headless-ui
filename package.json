{
    "name": "headless-ui-workspace",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace=packages/core",
        "typecheck": "npm run typecheck --workspaces",
        "test": "vitest run",
        "dev": "npm run dev --workspace=packages/playground",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.12.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.4.8",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.1",
        "happy-dom": "^20.9.0",
        "prettier": "^3.9.9",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.5",
        "vue": "^3.5.32",
        "vue-tsc": "^3.2.6"
    }
}
