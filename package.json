{
    "name": "headless-ui-workspace",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/components",
        "build:components": "npm run build --workspace=packages/components",
        "typecheck": "npm run typecheck --workspaces",
        "typecheck:components": "npm run typecheck --workspace=packages/components",
        "test": "vitest run",
        "test:components": "vitest run packages/components/src",
        "check": "npm run lint && npm run format:check && npm run typecheck",
        "check:components": "eslint packages/components --max-warnings 0 && prettier --check packages/components && npm run typecheck:components",
        "dev": "npm run dev --workspace=packages/playground",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
        "ci:components": "npm run check:components && npm run test:components && npm run build:components"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.4.8",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.1",
        "happy-dom": "^20.9.0",
        "prettier": "^3.9.9",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.5",
        "vue": "^3.5.32",
        "vue-tsc": "^3.2.6"
    }
}
